DATABASE_URL=postgres://fixflow:fixflow@localhost:5432/fixflow
JWT_SECRET=change-me-in-production
PORT=3000
UPLOAD_DIR=./uploads
APP_TIMEZONE=America/Toronto
# Leave empty to run the agent in local rules mode (no API calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_WORKER_ENABLED=true
AGENT_POLL_MS=1500
# Nightly digest schedule (cron, server time zone = APP_TIMEZONE)
NIGHTLY_CRON=0 6 * * *
